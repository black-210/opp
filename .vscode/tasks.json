{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mojo: Run current file",
      "type": "shell",
      "command": "mojo",
      "args": [
        "run",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
